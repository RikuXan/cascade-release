{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "setup-crane only publishes two-part tags, which the SemVer pinning preset filters out",
      "matchPackageNames": [
        "imjasonh/setup-crane"
      ],
      "extractVersion": "^(?<version>v\\d+\\.\\d+)$",
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions handed to setup actions, preceded by a '# renovate: datasource=... depName=...' comment",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ]
}
